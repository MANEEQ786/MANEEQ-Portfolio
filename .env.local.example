# ----------------------------------------------------------------------------
# Contact form (app/api/contact/route.ts) email delivery.
# These are OPTIONAL. If they are not set, the API still validates the form and
# returns a success message, but no email is actually sent (safe no-op).
# Copy this file to ".env.local" and fill in real values to enable sending.
# ----------------------------------------------------------------------------

# Where contact submissions should be delivered.
CONTACT_TO_EMAIL=example@example.com

# SMTP credentials (only required if you wire up a real mail transport).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ----------------------------------------------------------------------------
# Platform refresh cron (app/api/cron/refresh-platforms).
# Runs Mon/Wed/Fri 09:00 UTC (= 14:00 PKT) on Vercel Cron and refreshes the
# LinkedIn / X / GitHub / Upwork / blog snapshots into persistent storage.
# ----------------------------------------------------------------------------

# Shared secret that protects the cron + status endpoints. Vercel sends it as
# `Authorization: Bearer ${CRON_SECRET}` automatically. Generate a long random
# value (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# Apify (LinkedIn, X/Twitter, Upwork scrapers).
APIFY_TOKEN=

# LinkedIn
LINKEDIN_PROFILE=smasoodpk
APIFY_LINKEDIN_ACTOR=apimaestro/linkedin-profile-posts
LINKEDIN_TOTAL_POSTS=12

# X / Twitter
X_PROFILE=isaqibmasood
APIFY_X_ACTOR=xtdata/twitter-x-user-tweets-scraper
X_TOTAL_POSTS=50
X_MAX_TRIES=5

# GitHub (token optional, raises the rate limit)
GITHUB_USER=msmasood
GITHUB_TOKEN=
GITHUB_TOP_REPOS=6

# Upwork
UPWORK_USERNAME=smasoodpk
UPWORK_SEARCH_QUERY=Saqib Masood
APIFY_UPWORK_ACTOR=parseforge/upwork-freelancers-scraper

# Persistent snapshot storage.
# Default (Hostinger / VPS / local dev): snapshots are written to the filesystem
# — no extra config needed. Optionally point SNAPSHOT_DIR at a path OUTSIDE the
# deploy directory so snapshots survive re-uploading/rebuilding the app:
#   SNAPSHOT_DIR=/home/youruser/portfolio-data
SNAPSHOT_DIR=

# ONLY for Vercel hosting: set a Blob read-write token to use Vercel Blob instead
# of the filesystem (Vercel's serverless disk is ephemeral). Leave EMPTY on
# Hostinger — the filesystem backend is used automatically.
BLOB_READ_WRITE_TOKEN=

# Deployed site URL — used by the Hostinger cron (scripts/cron-hostinger.sh) and
# the manual test script (scripts/test-refresh-endpoint.mjs).
SITE_URL=https://yourdomain.com
CRON_URL=https://yourdomain.com
